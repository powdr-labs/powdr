diff --git a/bin/reth-benchmark/src/lib.rs b/bin/reth-benchmark/src/lib.rs
index 0c22494..08c7a4b 100644
--- a/bin/reth-benchmark/src/lib.rs
+++ b/bin/reth-benchmark/src/lib.rs
@@ -6,7 +6,7 @@ use powdr_openvm_riscv::StagedPipeline;
 
 use alloy_provider::RootProvider;
 use alloy_rpc_client::RpcClient;
-use alloy_transport::layers::RetryBackoffLayer;
+use alloy_transport::layers::{RateLimitRetryPolicy, RetryBackoffLayer};
 use clap::Parser;
 use openvm_circuit::arch::*;
 use openvm_rpc_proxy::{RpcExecutor, DEFAULT_PREIMAGE_CACHE_NIBBLES};
@@ -414,7 +414,14 @@ pub async fn precompute_prover_data(
     // Build `PgoConfig.inputs` as serialized stdins so the make_pgo_profile
     // closure can be a pure function of `(guest, inputs)` — and so the
     // staged cache key sees them.
-    let generate = default_generate_config();
+    let mut generate = default_generate_config();
+    // Dump the APC candidates ranking (consumed by powdr's
